<!-- ================= INTRODUCTION ================= -->

<section class="about-intro">

    <div class="about-container">

        <div class="intro-grid">

            <div class="intro-left">

                <div class="section-label">
                    WHO WE ARE
                </div>

                <h2>
                    More than a learning
                    <span>platform.</span>
                </h2>

            </div>


            <div class="intro-right">

                <p class="intro-large">

                    Capacity Connect is a digital capacity-building
                    and learning management platform created to make
                    professional learning more connected, accessible
                    and meaningful.

                </p>

                <p>

                    The platform brings learners and teachers together
                    through courses, learning resources, educational
                    activities and digital collaboration.

                </p>

                <p>

                    Our goal is simple — create an environment where
                    people can continuously learn, develop their
                    capabilities and grow with confidence.

                </p>

            </div>

        </div>

    </div>

</section>


